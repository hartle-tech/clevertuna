# In-pod Caddy serving clevertuna.hartle.tech.
# Edge TLS and apex routing are handled by the host Caddy on the VPS.

:8080 {
	root * /srv
	encode gzip zstd
	file_server

	# The page changes on every deploy and a long edge cache makes a shipped
	# fix look like it never went out. The assets beside it are content-stable.
	@html path / /index.html
	header @html Cache-Control "public, max-age=60"

	@immutable path /shots/* /vendor/*
	header @immutable Cache-Control "public, max-age=604800, immutable"

	# Go's mime table has no entry for .webmanifest, so without this it goes
	# out as application/octet-stream and the install prompt never appears.
	@manifest path /site.webmanifest
	header @manifest Content-Type "application/manifest+json"

	header {
		Cache-Control "public, max-age=600"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "interest-cohort=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# Everything the page needs comes from this origin: no CDN, no font
		# service, no analytics. anime.js is vendored into vendor/ for exactly
		# this reason — a script-src that has to name a third party is a
		# third party that can change what runs on the page.
		#
		# 'unsafe-inline' is not here and must not be: there is no inline
		# script and no inline style in index.html.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}

	# A single page: anything else is a typo, not a route.
	handle_errors {
		@404 expression {err.status_code} == 404
		rewrite @404 /index.html
		file_server
	}
}
