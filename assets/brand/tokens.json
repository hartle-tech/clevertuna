{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "brand": {
    "color": {
      "abyss": { "$type": "color", "$value": "#1C1949" },
      "ink": { "$type": "color", "$value": "#07101F" },
      "reef": { "$type": "color", "$value": "#0096FF" },
      "current": { "$type": "color", "$value": "#00C8FF" },
      "mint": { "$type": "color", "$value": "#36F0B1" },
      "trench": { "$type": "color", "$value": "#FF00E8" },
      "coral": { "$type": "color", "$value": "#FF5353" },
      "amber": { "$type": "color", "$value": "#FFB100" },
      "foam": { "$type": "color", "$value": "#F4F7FB" },
      "white": { "$type": "color", "$value": "#FFFFFF" },
      "mist": { "$type": "color", "$value": "#D7DDE3" },
      "muted": { "$type": "color", "$value": "#8A8B8B" }
    },
    "gradient": {
      "current": {
        "$type": "gradient",
        "$value": [
          { "color": "#0096FF", "position": 0 },
          { "color": "#00C8FF", "position": 0.52 },
          { "color": "#36F0B1", "position": 1 }
        ]
      },
      "spectral": {
        "$type": "gradient",
        "$value": [
          { "color": "#FF5353", "position": 0 },
          { "color": "#00C8FF", "position": 0.29 },
          { "color": "#FFFFFF", "position": 0.51 },
          { "color": "#FF00E8", "position": 0.78 },
          { "color": "#00C2FF", "position": 1 }
        ]
      }
    },
    "font": {
      "display": { "$type": "fontFamily", "$value": "Sora" },
      "body": { "$type": "fontFamily", "$value": "Inter" },
      "mono": { "$type": "fontFamily", "$value": "JetBrains Mono" }
    },
    "radius": {
      "sm": { "$type": "dimension", "$value": "8px" },
      "md": { "$type": "dimension", "$value": "14px" },
      "lg": { "$type": "dimension", "$value": "22px" },
      "pill": { "$type": "dimension", "$value": "999px" }
    },
    "space": {
      "1": { "$type": "dimension", "$value": "4px" },
      "2": { "$type": "dimension", "$value": "8px" },
      "3": { "$type": "dimension", "$value": "12px" },
      "4": { "$type": "dimension", "$value": "16px" },
      "6": { "$type": "dimension", "$value": "24px" },
      "8": { "$type": "dimension", "$value": "32px" },
      "12": { "$type": "dimension", "$value": "48px" }
    },
    "motion": {
      "quick": { "$type": "duration", "$value": "120ms" },
      "base": { "$type": "duration", "$value": "180ms" },
      "slow": { "$type": "duration", "$value": "280ms" }
    }
  },
  "semantic": {
    "surface": {
      "canvas": { "$type": "color", "$value": "#F4F7FB" },
      "panel": { "$type": "color", "$value": "#FFFFFF" },
      "inverse": { "$type": "color", "$value": "#1C1949" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#07101F" },
      "secondary": { "$type": "color", "$value": "#5B6472" },
      "inverse": { "$type": "color", "$value": "#FFFFFF" }
    },
    "action": {
      "primary": { "$type": "color", "$value": "#00C8FF" },
      "focus": { "$type": "color", "$value": "#FF00E8" },
      "selected": { "$type": "color", "$value": "#36F0B1" }
    },
    "status": {
      "ready": { "$type": "color", "$value": "#36F0B1" },
      "working": { "$type": "color", "$value": "#00C8FF" },
      "warning": { "$type": "color", "$value": "#FFB100" },
      "error": { "$type": "color", "$value": "#FF5353" },
      "unknown": { "$type": "color", "$value": "#8A8B8B" }
    }
  }
}
