// Clevertuna in waybar.
//
// Add "custom/clevertuna" to one of the module lists, then merge this in. The
// module polls the binary, which prints one line of JSON per tick.
//
// Left click opens the picker (gallery + actions); right click matches the
// wallpaper straight away.
{
  "custom/clevertuna": {
    "exec": "clevertuna menu --format waybar",
    "return-type": "json",
    "interval": 10,
    "on-click": "~/.config/waybar/scripts/clevertuna-menu.sh",
    "on-click-right": "clevertuna do match-wallpaper",
    "tooltip": true
  }
}
